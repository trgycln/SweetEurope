}

const supabase = createClient(url, serviceRoleKey);

async function fixRemainingIssues() {
  console.log('🔧 Son kalan sorunları düzelt\n');

  const fixes = [
    {
      id: 'f314f9c2-53cc-4dc2-8574-2e8bf2d01a8e',

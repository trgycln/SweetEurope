        # Update Supabase with retry
        for sb_attempt in range(3):
            try:
                slug = filename.split('_', 1)[-1]
                get_res = requests.get(f"{SUPABASE_URL}/rest/v1/urunler?slug=eq.{slug}", headers=headers, timeout=20)
                rows = get_res.json()

                                        <YAxis type="category" dataKey="name" width={120} tick={{ fontSize: 10 }}
                                               tickFormatter={(v: string) => truncate(v, 18)} />
                                        <Tooltip formatter={(v: any) => fmt(v)} />
                                        <Bar dataKey="totalRevenue" name="Ciro" radius={[0, 4, 4, 0]}>

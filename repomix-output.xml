  zitrone: { de: 'Zitrone', tr: 'Limon', en: 'Lemon', ar: 'ليمون' },
  kaffee: { de: 'Kaffee', tr: 'Kahve', en: 'Coffee', ar: 'قهوة' },
  honig: { de: 'Honig', tr: 'Bal', en: 'Honey', ar: 'عسل' },
  hindistancevizi: { de: 'Kokos', tr: 'Hindistan cevizi', en: 'Coconut', ar: 'جوز الهند' },

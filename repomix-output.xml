                    klasorler={klasorler}
                    onOpenNewFolderModal={() => setFolderModalOpen(true)}
                />
            )}

            {/* ── Add Folder Modal ── */}
            {folderModalOpen && (
                <AddFolderModal
                    onClose={() => setFolderModalOpen(false)}
                    onSuccess={handleCreateFolderSuccess}
                />
            )}
        </div>
    );
}

                          {review.id.startsWith('sim-') ? 'Simülasyon Tamamlandı' : `Google Haritalar'da Yayınlandı (${new Intl.DateTimeFormat('tr-TR', { hour: '2-digit', minute:'2-digit' }).format(new Date(review.replied_at))})`}
                        </div>
                      </div>

                    </div>
                  ))}
                </div>
              </motion.div>
            )}

          </AnimatePresence>
        )}
      </div>
    </div>
  );
}

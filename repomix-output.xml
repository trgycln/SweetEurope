                <Bar dataKey="gider" name="Gider" fill="#EF4444" radius={[4, 4, 0, 0]} />
                <Line
                    type="monotone"
                    dataKey="net"
                    name="Net Kâr"
                    stroke="#10B981"
                    strokeWidth={2.5}
                    dot={{ r: 4, fill: '#10B981' }}
                />
            </ComposedChart>
        </ResponsiveContainer>
    );
}

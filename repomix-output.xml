                    </div>

                    {/* Aksiyonlar */}
                    <div className="flex items-center gap-2 flex-shrink-0 flex-wrap">
                        {/* Lieferschein / İrsaliye Yazdır Butonu */}
                        <Link
                            href={`/${locale}/print/lieferschein/${siparis.id}`}

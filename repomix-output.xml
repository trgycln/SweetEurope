                                                        : `${fmtNumber(row.kPor)} ${row.unit}`}
                                                </span>
                                            )}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        {/* ── Category template specs ──────────────────────── */}
                        {specRows.length > 0 && (
                            <div>
                                <h3 className="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-2 flex items-center gap-1.5">
                                    <FiInfo size={11} /> {lc.specs}

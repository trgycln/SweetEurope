                            <strong>%{avgMargin.toFixed(1)}</strong> olarak gerçekleşmiştir.
                            {profPeriods < data.length && ` ${lossPeriods} dönem zararda kapanmıştır.`}
                        </p>
                    </div>
                </>
            )}
        </div>
    );
}

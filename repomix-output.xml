  aciklama text,
  genel_indirim_yuzdesi numeric(5,2) DEFAULT 0, -- -5.00 = %5 indirim, +2.00 = %2 artış
  aktif boolean DEFAULT true,
  sira_no integer DEFAULT 0, -- UI'da sıralama için

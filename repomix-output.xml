            <span className="border border-secondary/20 rounded px-2 py-0.5">HACCP</span>
            <span className="border border-secondary/20 rounded px-2 py-0.5">
              {locale === 'ar' ? 'حلال · BRC' : locale === 'tr' ? 'BRC · Helal' : 'BRC · Halal'}
            </span>
          </div>

          #print-order-list button {
            display: none !important;
          }

          #print-order-list .print-only {
            display: inline !important;
          }

          #print-order-list table {
            font-size: 10.5px !important;
          }

          #print-order-list th,
          #print-order-list td {
            padding: 3px 5px !important;
          }

          @page {
            size: A4 landscape;

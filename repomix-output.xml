};

// Gemini Function Declarations
const TOOLS_SPEC = [
  {
    functionDeclarations: [
      {
        name: 'searchProducts',
        description: 'Suche nach Produkten im Elyson Sweets Sortiment anhand von Namen, Kategorie oder Geschmack (z.B. "Blue Curacao", "Haselnuss", "Pistazie", "Fruchtpüree").',

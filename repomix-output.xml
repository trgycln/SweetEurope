/* src/app/globals.css */
@tailwind base;
@tailwind components;
@tailwind utilities;

body {
  @apply bg-secondary text-text-main font-sans overflow-x-hidden;
}

h1, h2, h3, h4, h5, h6 {
  @apply font-serif text-primary;
}

@keyframes marquee {
  0% { transform: translateX(100%); }
  100% { transform: translateX(-100%); }
}

.animate-marquee {
  animation: marquee 30s linear infinite;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fadeIn {
  animation: fadeIn 0.3s ease-out;
}

@layer utilities {
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }

  /* Ultra-sleek custom scrollbar for Admin Main Area & Tables */
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: rgba(148, 163, 184, 0.5) transparent;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.4);
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(100, 116, 139, 0.7);
  }

  /* Elegant dark theme scrollbar for Sidebar */
  .custom-sidebar-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
  }
  .custom-sidebar-scrollbar::-webkit-scrollbar {
    width: 5px;
  }
  .custom-sidebar-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-sidebar-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 9999px;
  }
  .custom-sidebar-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.35);
  }
}

/* ========================================
   GLOBAL PRINT STYLES
   Reçete ve doküman baskıları için
   kusursuz, saf beyaz, yüksek kontrastlı tasarım.
   ======================================== */
@media print {
  /* 1. Sayfa boyutlandırması ve kenar boşlukları */
  @page {
    size: A4 portrait;
    margin: 1.2cm 1.5cm;
  }

  /* 2. WebGL Canvas, animasyonlar ve baskıda gereksiz tüm overlay'ler KESİNLİKLE GİZLENİR */
  canvas,
  .print\:hidden,
  button,
  [role="button"],
  nav,
  div[class*="ForegroundFluidOverlay"],
  div[class*="fixed"] {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
  }

  /* 3. Saf beyaz zemin - arka planda leke, gradient veya renk kalmasın */
  html,
  body,
  .locale-wrapper,
  main,
  article,
  section,
  [class*="bg-gradient"],
  [class*="bg-[#FBF9F5]"],

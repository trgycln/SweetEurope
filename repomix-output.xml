      oncelik: oncelik,
      tamamlandi: false,
      durum: 'Yapılacak', // Standard-Status setzen (falls Spalte 'durum' verwendet wird)
  };

  const { error } = await supabase.from('gorevler').insert(insertData as any);

  if (error) {
    console.error('Fehler beim Hinzufügen der Aufgabe:', error.message);

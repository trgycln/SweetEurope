  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public'
      AND table_name = 'urunler'
      AND column_name = 'palet_ici_adet'
  ) THEN
    ALTER TABLE public.urunler ADD COLUMN palet_ici_adet integer;

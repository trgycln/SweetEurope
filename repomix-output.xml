    ('Yazılım & IT',     '{"de":"Software & IT","tr":"Yazılım & IT"}'::jsonb),
    ('Diğer',            '{"de":"Sonstiges","tr":"Diğer"}'::jsonb)
) AS v(ad, ad_translations)
WHERE NOT EXISTS (SELECT 1 FROM gider_ana_kategoriler WHERE ad = v.ad);


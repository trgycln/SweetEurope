ON storage.objects
FOR UPDATE
TO authenticated
USING (
    bucket_id = 'documents' 
    AND (
        (SELECT role FROM profiles WHERE id = auth.uid()) = 'admin'
        OR
        (storage.foldername(name))[1] = auth.uid()::text
    )
)

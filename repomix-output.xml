    console.log(`  ${i + 1}. [${p.id}] ${name} | urun_gami: ${JSON.stringify(p.urun_gami)}`);
  });
  if (frozenProducts.length > 10) {
    console.log(`  ... ve ${frozenProducts.length - 10} tane daha.\n`);
  }

  if (isDryRun) {
    console.log('\n⚠️  DRY RUN modu - Gerçek güncelleme yapılmadı.');

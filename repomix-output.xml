    const sipDag = (siparisDagRes.data || []) as Array<{ siparis_durumu: string }>;
    const sipCount = (statuses: string[]) => sipDag.filter(d => statuses.includes(d.siparis_durumu)).length;

    const sonTir      = (sonTirRes.data || [])[0] ?? null;

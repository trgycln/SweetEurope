      ? 'bg-blue-600 text-white shadow-md shadow-blue-500/20' 
      : 'bg-white text-gray-600 hover:bg-gray-50 border border-gray-100'}
  `;

  return (
    <div className="min-h-screen bg-[#F8FAFC] pb-20">
      {/* Header */}

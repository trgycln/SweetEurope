const brutGida = Number((netGidaTutar + kdvGida).toFixed(2));
assert(kdvGida === 7.0, 'KDV %7 gıda: 100 € net -> 7.00 € KDV');
assert(brutGida === 107.0, 'KDV %7 gıda: 100 € net -> 107.00 € brüt');

// 4.2 Kargo KDV Tutarsızlığı Denetimi:

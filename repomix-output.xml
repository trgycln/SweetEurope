            </td>

            {/* 3. Durum (Asana Pill Select) */}
            <td className="w-36 px-2 py-2 align-middle">
                <div className="relative inline-block w-full">
                    <select
                        value={g.durum}
                        onChange={e => onStatusChange(g.id, e.target.value as GorevDurumu)}

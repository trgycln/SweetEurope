        -- Marketing
        WHEN 'Online-Werbung' THEN 'Online Advertising'
        WHEN 'Social Media' THEN 'Social Media'
        WHEN 'Printmedien' THEN 'Print Media'
        WHEN 'Veranstaltungen' THEN 'Events'
        
        -- Verwaltung

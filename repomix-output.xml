                    <span className="text-sm font-semibold text-amber-800 flex items-center gap-2">
                        <FiAlertTriangle size={14} />
                        {giderler.filter(g => g.durum === 'Taslak').length} gider onay bekliyor
                    </span>
                    <button onClick={() => setActiveChip('bekleyen')}

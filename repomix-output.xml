    END,
    'en', CASE ad
        WHEN 'Betriebskosten' THEN 'Operating Costs'
        WHEN 'Personalkosten' THEN 'Personnel Costs'
        WHEN 'Marketing & Werbung' THEN 'Marketing & Advertising'
        WHEN 'Verwaltungskosten' THEN 'Administrative Costs'

                                        </td>
                                        <td />
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    {/* Margin Trend Note */}
                    <div className="bg-blue-50 border border-blue-100 rounded-xl px-5 py-3.5 flex items-start gap-3">
                        <FiActivity className="text-blue-400 flex-shrink-0 mt-0.5" size={14} />

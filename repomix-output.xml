  kirsche: { de: 'Kirsche', tr: 'Vişne', en: 'Cherry', ar: 'كرز' },
  // Alias token for Turkish input 'visne' (normalized to kirsche in actions)
  visne: { de: 'Kirsche', tr: 'Vişne', en: 'Cherry', ar: 'كرز' },

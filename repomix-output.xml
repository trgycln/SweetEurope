const fiyatRaporu = JSON.parse(fs.readFileSync('fiyat_raporu.json', 'utf8'));
console.log(`Hala Fiyatı Olmayan/Eşleşmeyen DB Ürün Sayısı: ${fiyatRaporu.notFoundInPdf.length}`);

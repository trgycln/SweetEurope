} else if (isProduction && vercelEnv === 'production' && !isStripeLiveKey) {
  console.warn('⚠️ DİKKAT: Canlı ortamda (Production) Stripe TEST anahtarı (sk_test_) tanımlı. Gerçek ödemeler alınamaz.');
}

/**

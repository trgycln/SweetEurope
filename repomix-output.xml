      <tr><td style="padding:6px 0;font-weight:bold">E-posta:</td><td><a href="mailto:${email}">${email}</a></td></tr>
      <tr><td style="padding:6px 0;font-weight:bold">Telefon:</td><td>${telefon || '—'}</td></tr>

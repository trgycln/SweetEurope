        WHEN 'Sonstige Ausgaben' THEN 'مصروفات أخرى'
        WHEN 'Steuern & Abgaben' THEN 'الضرائب والرسوم'
        WHEN 'Finanzierungskosten' THEN 'تكاليف التمويل'
